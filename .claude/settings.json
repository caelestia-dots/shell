{
    "permissions": {
        "deny": [
            "Bash(git push:*)",
            "Bash(sudo:*)",
            "Bash(cmake --install:*)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 -I \"$CLAUDE_PROJECT_DIR/scripts/agent-guard.py\"",
                        "timeout": 5
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 -I \"$CLAUDE_PROJECT_DIR/scripts/agent-check.py\" --hook",
                        "timeout": 660,
                        "statusMessage": "Verificando lint y build"
                    }
                ]
            }
        ]
    }
}
