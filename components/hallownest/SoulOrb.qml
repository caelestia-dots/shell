Item {
    id: root

    property real level
    property color colour: Hallownest.soul
    property bool running
    property real phase
    property real eyesAt: 0.8
    property real shown: Math.max(0, Math.min(1, level))
    readonly property bool eyes: shown >= eyesAt

    function wave(offset: real, amp: real): string {
        const w = liquid.width;
        const h = liquid.height;
        const y0 = h * (1 - shown);
        let d = `M 0 ${y0 + Math.sin(phase + offset) * amp}`;
        for (let i = 1; i <= 16; i++) {
            const x = w * i / 16;
            d += ` L ${x} ${y0 + Math.sin(phase + offset + i / 16 * Math.PI * 2) * amp}`;
        }
        return d + ` L ${w} ${h} L 0 ${h} Z`;
    }

    implicitWidth: 112
    implicitHeight: 112

    Behavior on shown {
        Anim {
            type: Anim.DefaultSpatial
        }
    }

    NumberAnimation on phase {
        running: root.running && root.visible
        loops: Animation.Infinite
        from: 0
        to: Math.PI * 2
        duration: 2600
    }

    ClippingRectangle {
        id: liquid

        anchors.centerIn: parent
        width: root.width * 27 / 28
        height: width
        radius: width / 2
        color: "transparent"

        Shape {
            anchors.fill: parent
            preferredRendererType: Shape.CurveRenderer

            ShapePath {
                fillColor: Qt.alpha(root.colour, 0.25)
                strokeWidth: -1

                PathSvg {
                    path: root.wave(Math.PI, liquid.height / 37)
                }
            }

            ShapePath {
                fillColor: Qt.alpha(root.colour, 0.5)
                strokeWidth: -1

                PathSvg {
                    path: root.wave(0, liquid.height / 45)
                }
            }
        }
    }

