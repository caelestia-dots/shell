#!/bin/bash
set -euo pipefail

# Open config files in the configured terminal editor.
# Editor resolution order: menu.conf (MENU_EDITOR) -> $EDITOR -> nvim -> nano -> vi.

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/caelestia/menu/menu.conf"
[[ -f $CONF ]] && source "$CONF"

if (( $# == 0 )); then
  echo "Usage: menu-edit <file> [file...]" >&2
  exit 1
fi

if [[ -n ${MENU_EDITOR:-} ]]; then
  read -ra editor_cmd <<<"$MENU_EDITOR"
elif [[ -n ${EDITOR:-} ]]; then
  read -ra editor_cmd <<<"$EDITOR"
elif command -v nvim >/dev/null 2>&1; then
  editor_cmd=(nvim)
elif command -v nano >/dev/null 2>&1; then
  editor_cmd=(nano)
else
  editor_cmd=(vi)
fi

exec menu-term-exec --class "org.caelestia.menu.editor" --title "Caelestia Menu Editor" -- "${editor_cmd[@]}" "$@"
