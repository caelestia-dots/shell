#!/usr/bin/env python3
"""Synchronize Caelestia's palette and wallpaper into its SDDM theme."""

import json
import os
import shutil
from pathlib import Path


def scheme_data() -> tuple[dict[str, str], str]:
    raw = os.environ.get("SCHEME_COLOURS")
    if raw:
        try:
            return json.loads(raw), os.environ.get("SCHEME_MODE", "dark")
        except json.JSONDecodeError:
            pass
    path = Path.home() / ".local/state/caelestia/scheme.json"
    if path.exists():
        try:
            data = json.loads(path.read_text())
            return data.get("colours", {}), data.get("mode", "dark")
        except (OSError, json.JSONDecodeError):
            pass
    return {}, "dark"


def wallpaper() -> Path | None:
    path = Path.home() / ".local/state/caelestia/wallpaper/path.txt"
    if path.exists():
        candidate = Path(path.read_text().strip())
        if candidate.is_file():
            return candidate
    current = Path.home() / ".local/state/caelestia/wallpaper/current"
    return current.resolve() if current.is_symlink() and current.resolve().is_file() else None


def main() -> None:
    theme = Path(os.environ.get("CAELESTIA_SDDM_THEME_DIR", "/usr/share/sddm/themes/caelestia"))
    config = theme / "theme.conf"
    colours, mode = scheme_data()
    if not colours:
        raise SystemExit("Caelestia scheme data is unavailable")

    get = colours.get
    surface = get("surface", "1e1e2e")
    container = get("surfaceContainer", surface)
    high = get("surfaceContainerHigh", container)
    on_surface = get("onSurface", "ffffff" if mode == "dark" else "000000")
    on_variant = get("onSurfaceVariant", on_surface)
    primary = get("primary", "b4befe")
    secondary = get("secondary", primary)
    on_primary = get("onPrimary", surface)
    secondary_container = get("secondaryContainer", high)
    on_secondary_container = get("onSecondaryContainer", on_surface)
    alpha = "E6"

    backgrounds = theme / "backgrounds"
    backgrounds.mkdir(parents=True, exist_ok=True)
    wall = wallpaper()
    if wall:
        destination = backgrounds / f"caelestia_wallpaper{wall.suffix or '.png'}"
        shutil.copy2(wall, destination)
        background = f"backgrounds/{destination.name}"
    else:
        background = "backgrounds/default.svg"

    config.write_text(f'''[General]
BgSource="{background}"
FontFamily="Google Sans Flex"
FontSize=10
Padding=45
Radius=16
Scale=1
UserPictureEnabled=false
UserBorderWidth=4
UserBorderColor="#{primary}"
UserColor="#{alpha}{high}"
InputColor="#{alpha}{container}"
InputTextColor="#{on_surface}"
InputBorderWidth=2
InputBorderColor="#{primary}"
UserPlaceholderText="User"
PassPlaceholderText="Password"
HidePassword=true
LoginButtonTextColor="#{on_primary}"
LoginButtonText="Login"
LoginButtonColor="#{primary}"
PopupColor="#{alpha}{container}"
PopupActiveColor="#{primary}"
PopupActiveTextColor="#{on_primary}"
SessionButtonColor="#{alpha}{secondary_container}"
SessionIconColor="#{on_secondary_container}"
PowerButtonColor="#{alpha}{secondary_container}"
PowerIconColor="#{on_secondary_container}"
DateColor="#{on_variant}"
DateSize=16
DateIsBold=true
DateOpacity=0.85
DateFormat="dddd • d MMM"
TimeColor="#{primary}"
TimeSecondaryColor="#{secondary}"
ClockChipColor="#{alpha}{high}"
ClockChipTextColor="#{on_surface}"
ClockHourSize=84
ClockMinuteSize=46
ClockAmPmSize=18
TimeIsBold=true
TimeOpacity=1.0
TimeFormat="hh:mm AP"
''')


if __name__ == "__main__":
    main()
